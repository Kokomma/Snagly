{
  "framework": "nextjs",
  "regions": ["lhr1"],
  "schedules": {
    "hourly-discovery": {
      "path": "/api/cron",
      "schedule": "0 * * * *",
      "requestMethod": "GET",
      "timezone": "Africa/Lagos",
      "jitter": 15
    }
  },
  "functions": { "app/api/cron/route.js": { "maxDuration": 300 } }
}
