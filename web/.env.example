# Configure directly in the hosting provider; do not commit real values.
OWNER_PASSWORD=
SESSION_SECRET=
FIREBASE_PROJECT_ID=snagly-personal-kokomma
FIRESTORE_DATABASE_ID=snagly
FIREBASE_WEB_API_KEY=
APP_ORIGIN=https://snagly-personal.vercel.app
# Server-only JSON service-account credential. Never use a NEXT_PUBLIC_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
# Optional email submission. Keep disabled until you configure permissions in Snagly.
ENABLE_SUBMISSIONS=false
RESEND_API_KEY=
APPLICATION_FROM=
# Dedicated Gemini project must have billing disabled for free-only use.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_FREE_TIER_CONFIRMED=false
AI_FREE_MODEL=gemini-3.5-flash-lite
CONNECTOR_GMAIL=
CONNECTOR_OUTLOOK=
